CREATE DATABASE IF NOT EXISTS `pawpal_db`;
USE `pawpal_db`;

CREATE TABLE IF NOT EXISTS `tbl_user` (
  `user_id` int(5) NOT NULL AUTO_INCREMENT,
  `name` varchar(100) NOT NULL,
  `email` varchar(100) NOT NULL,
  `password` varchar(255) NOT NULL, -- Will store SHA1 hashed password [cite: 16]
  `phone` varchar(20) DEFAULT NULL,
  `profile_image` varchar(255) DEFAULT 'default_user.png', -- For Task 4
  `reg_date` datetime NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`user_id`),
  UNIQUE KEY `email` (`email`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS `tbl_pets` (
  `pet_id` int(11) NOT NULL AUTO_INCREMENT,
  `user_id` int(5) NOT NULL,
  `pet_name` varchar(100) NOT NULL,
  `pet_type` varchar(50) NOT NULL, -- Cat, Dog, Other [cite: 40]
  `pet_age` int(3) DEFAULT NULL, -- For Task 1 & 2 [cite: 38]
  `gender` varchar(10) DEFAULT 'Unknown',
  `health_status` varchar(255) DEFAULT 'Healthy',
  `category` varchar(50) NOT NULL, -- Adoption, Donation Request, Help [cite: 50]
  `description` text DEFAULT NULL,
  `image_paths` text DEFAULT NULL, -- Stores comma-separated filenames [cite: 16]
  `lat` varchar(50) DEFAULT NULL,
  `lng` varchar(50) DEFAULT NULL,
  `created_at` datetime NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`pet_id`),
  CONSTRAINT `fk_pet_user` FOREIGN KEY (`user_id`) REFERENCES `tbl_user` (`user_id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS `tbl_adoptions` (
  `adoption_id` int(11) NOT NULL AUTO_INCREMENT,
  `pet_id` int(11) NOT NULL,
  `user_id` int(5) NOT NULL,
  `motivation` text NOT NULL, -- Motivation message [cite: 46]
  `request_date` datetime DEFAULT current_timestamp(),
  PRIMARY KEY (`adoption_id`),
  CONSTRAINT `fk_adopt_pet` FOREIGN KEY (`pet_id`) REFERENCES `tbl_pets` (`pet_id`) ON DELETE CASCADE,
  CONSTRAINT `fk_adopt_user` FOREIGN KEY (`user_id`) REFERENCES `tbl_user` (`user_id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS `tbl_donations` (
  `donation_id` int(11) NOT NULL AUTO_INCREMENT,
  `user_id` int(5) NOT NULL,
  `pet_id` int(11) DEFAULT NULL,
  `donation_type` varchar(20) NOT NULL, -- Food, Medical, Money [cite: 51]
  `amount` double DEFAULT 0, -- For money [cite: 52]
  `description` text DEFAULT NULL, -- For food/medical [cite: 53]
  `date_donated` datetime DEFAULT current_timestamp(),
  PRIMARY KEY (`donation_id`),
  CONSTRAINT `fk_donate_user` FOREIGN KEY (`user_id`) REFERENCES `tbl_user` (`user_id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;